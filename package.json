    "deploy:check": "cf deploy --prebuilt --mode production --dry-run",
    "deploy:smoke": "node scripts/smoke-deployment.ts",
    "release": "nr build && nlx bumpp",
    "analyze": "nlx node-modules-inspector"
  },
